<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SqlMcpServer</AssemblyName>
    <RootNamespace>SqlMcpServer</RootNamespace>
    <Version>1.0.0</Version>
    <Product>SQL Server MCP Server</Product>
    <Description>Read-only SQL Server MCP server speaking JSON-RPC over stdio.</Description>
    <!-- Users may run this on a machine with only a newer runtime installed. -->
    <RollForward>LatestMajor</RollForward>
    <!-- Chinese result sets must render correctly, so keep globalization data. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
  </ItemGroup>

</Project>
